{ 
    "coc.preferences.extensionUpdateCheck": "weekly",
    "coc.preferences.formatOnSaveFiletypes": ["css", "markdown", "c", "cpp", "python", "sh"],
    "latex.build.onSave": true,
    "latex.lint.onChange": true,
    "latex.forwardSearch.executable": "zathura",
    "latex.forwardSearch.args": ["--synctex-forward", "%l:1:%f", "%p"],
    "latex.build.executable": "/usr/bin/latexmk",
    "explorer.width": 30,
    "explorer.icon.enableNerdfont": true,
    "explorer.previewAction.onHover": false,
    "explorer.keyMappings": {
        "<cr>": ["expandable?", ["expanded?", "collapse", "expand"], "open"],
        "v": "open:vsplit"
    },
    "clangd.semanticHighlighting": true
    //"clangd.path": "/home/timothy/.config/coc/extensions/coc-clangd-data/install/10.0.0/clangd_10.0.0/bin/clangd"
}
