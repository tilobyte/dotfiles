### Key bindings
#
# Basics:
#
    # Start a terminal
    bindsym $mod+Return exec $term

    # Kill focused window
    # bindsym $mod+Shift+w kill
    bindsym $mod+q kill

    # Start your launcher
    bindsym $mod+Space exec $menu

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit sway (logs you out of your Wayland session)
    # bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit?' -b 'Yes, exit sway' 'swaymsg exit'

    # exit prompt
    bindsym $mod+shift+escape exec /usr/bin/nwgbar -o 0.2k
    # bindsym $mod+asciitilde exec /usr/bin/swaylock
    bindsym $mod+escape exec "loginctl lock-session $XDG_SESSION_ID"

#
# Moving around:
#
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # move focus between displays
    bindsym $mod+bracketleft focus output up
    bindsym $mod+bracketright focus output down
    #bindsym $mod+minus focus output up
    #bindsym $mod+equal focus output down
    # move focus between workspaces
    #bindsym $mod+left workspace prev_on_output
    #bindsym $mod+right workspace next_on_output
    bindsym $mod+minus workspace prev_on_output
    bindsym $mod+equal workspace next_on_output

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # move focused container between displays
    bindsym $mod+shift+bracketleft move container to output up
    bindsym $mod+shift+bracketright move container to output down
    #bindsym $mod+shift+minus move container to output up
    #bindsym $mod+shift+equal move container to output down
    # move focused container between workspaces
    #bindsym $mod+Shift+Left move container to workspace prev_on_output
    #bindsym $mod+Shift+Right move container to workspace next_on_output
    bindsym $mod+Shift+minus move container to workspace prev_on_output
    bindsym $mod+Shift+equal move container to workspace next_on_output
    # move focused workspace between displays
    # bindsym $mod+shift+minus move workspace to output left
    # bindsym $mod+shift+equal move workspace to output right
    bindsym $mod+shift+w move workspace to output up
    bindsym $mod+shift+r move workspace to output down

#
# Workspaces:
#

    # place initial workspaces
    workspace $ws1 output DP-1 eDP-1
    workspace $ws2 output eDP-1
    workspace $ws3 output eDP-1
    workspace $ws4 output DP-1 eDP-1
    workspace $ws5 output DP-1 eDP-1
    workspace $ws6 output DP-1 eDP-1
    workspace $ws7 output eDP-1
    workspace $ws8 output DP-1 eDP-1
    workspace $ws9 output DP-1 eDP-1
    workspace $ws0 output DP-1 eDP-1
    # workspace $ws1 output DP-1 eDP-1
    # workspace $ws2 output eDP-1
    # workspace $ws3 output eDP-1
    # workspace $ws4 output DP-1 eDP-1
    # workspace $ws5 output DP-1 eDP-1
    # workspace $ws6 output eDP-1
    # workspace $ws7 output eDP-1
    # workspace $ws8 output eDP-1
    # workspace $ws9 output DP-1 eDP-1
    # workspace $ws0 output DP-1 eDP-1

    # Switch to workspace
    bindsym $mod+1 workspace $ws1
    bindsym $mod+2 workspace $ws2
    bindsym $mod+3 workspace $ws3
    bindsym $mod+4 workspace $ws4
    bindsym $mod+5 workspace $ws5
    bindsym $mod+6 workspace $ws6
    bindsym $mod+7 workspace $ws7
    bindsym $mod+8 workspace $ws8
    bindsym $mod+9 workspace $ws9
    bindsym $mod+0 workspace $ws0
    # Move focused container to workspace
    bindsym $mod+Shift+0 move container to workspace $ws0
    bindsym $mod+Shift+1 move container to workspace $ws1
    bindsym $mod+Shift+2 move container to workspace $ws2
    bindsym $mod+Shift+3 move container to workspace $ws3
    bindsym $mod+Shift+4 move container to workspace $ws4
    bindsym $mod+Shift+5 move container to workspace $ws5
    bindsym $mod+Shift+6 move container to workspace $ws6
    bindsym $mod+Shift+7 move container to workspace $ws7
    bindsym $mod+Shift+8 move container to workspace $ws8
    bindsym $mod+Shift+9 move container to workspace $ws9

    # assign workspaces
    #assign [app_id="firefox"] $ws1
    # spotify requires for_window for some reason
    for_window [class="Spotify"] move to workspace $ws2
    assign [app_id="org.pwmt.zathura"] $ws5
    assign [class="zoom"] $ws6
    assign [class="Write"] $ws7
    assign [app_id="com.github.xournalpp.xournalpp"] $ws7
    #assign [class="Emacs"] opacity 0.92
#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $mod+b or $mod+v, for horizontal and vertical splits
    # respectively.
    bindsym $mod+o splith
    bindsym $mod+i splitv

    # Switch the current container between different layout styles
    bindsym $mod+comma layout stacking
    bindsym $mod+period layout tabbed
    bindsym $mod+slash layout toggle split

    # Make the current focus fullscreen
    bindsym $mod+u fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+M floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+m focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+n focus parent
    # Move focus to child
    bindsym $mod+e focus child

    # application-specific layout settings
    for_window [title="Firefox - Choose User Profile"] floating enable
    for_window [title="nmtui"] floating enable
    for_window [title="ncpamixer"] floating enable
    for_window [title="Volume Control"] floating enable
    for_window [title="KeePassXC - Browser Access Request"] floating enable
    for_window [title="Firefox - Sharing Indicator"] floating enable
    # for_window [class="zoom"] layout tabbed
    for_window [class="zoom"] floating enable

    # idle inhibition
    for_window [class="zoom"] inhibit_idle visible
    #for_window [app_id="mpv"] inhibit_idle fullscreen
    #for_window [app_id="firefox"] inhibit_idle fullscreen
#
# Scratchpad:
#
    # Sway has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later.

    # Move the currently focused window to the scratchpad
    bindsym $mod+Shift+apostrophe move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    bindsym $mod+apostrophe scratchpad show
#
# Resizing containers:
#
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize shrink height 10px
    bindsym $up resize grow height 10px
    bindsym $right resize grow width 10px

    bindsym Left resize shrink width 10px
    bindsym Down resize shrink height 10px
    bindsym Up resize grow height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+y mode "resize"

