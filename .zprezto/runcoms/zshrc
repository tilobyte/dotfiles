# Source Prezto.
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

# Customize to your needs...

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/home/akintilo/miniconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/home/akintilo/miniconda3/etc/profile.d/conda.sh" ]; then
        . "/home/akintilo/miniconda3/etc/profile.d/conda.sh"
    else
        export PATH="/home/akintilo/miniconda3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

# import aliases
source $HOME/.aliases

# get colors to work properly in tmux
export TERM=xterm-256color

# add doom emacs to PATH
export PATH="/home/akintilo/.emacs.d/bin:$PATH"

# X server stuff
# export DISPLAY=:0.0
# export XDG_RUNTIME_DIR=$HOME/xdg # temporary directory for X to use
# export RUNLEVEL=3
# sudo mkdir /var/run/dbus
# sudo dbus-daemon --config-file=/usr/share/dbus-1/system.conf

# move to home folder (WSL)
cd
